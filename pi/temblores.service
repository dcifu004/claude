[Unit]
Description=Revisa los sismos recientes y avisa si uno es relevante para la casa (encargo 91)
After=network-online.target
Wants=network-online.target
# A diferencia de avisos.service, este SÍ vive dentro del cifrado: escribe en la bandeja de salida y en el
# registro único (tres archivos de /opt/nodo/datos, de dcifu004; ver ReadWritePaths) y lee el perfil del
# bot. Con el volumen cerrado no corre, y avisos.service ya avisa de eso.
RequiresMountsFor=/opt/nodo/datos

[Service]
Type=oneshot
User=dcifu004
Group=dcifu004
ExecStart=/usr/bin/python3 /opt/nodo/datos/srv/vault_personal/10-Proyectos/11-Pi5/pi/temblores.py

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
# Lo único escribible (91b): su carpeta de estado y los TRES archivos del canal que usa
# encargos/registro_avisos.py en la raíz del volumen. NUNCA `/opt/nodo/datos` entero: eso abriría los
# vaults y el estado de los demás servicios.
#   avisos.jsonl          el registro único (append)
#   avisos-salida.jsonl   la bandeja de salida (append)
#   .avisos-salida.lock   el cerrojo (flock) que serializa a los que escriben la bandeja
# Los tres tienen que EXISTIR antes de arrancar (un ReadWritePaths a un archivo que falta hace fallar la
# unidad): el despliegue los crea una vez, de dcifu004 y 0664, con
#   install -o dcifu004 -g dcifu004 -m 0664 /dev/null /opt/nodo/datos/<archivo>   (solo si falta)
# y crea la carpeta /opt/nodo/datos/temblores (0750). Como la raíz queda de solo lectura, este servicio no
# puede RECORTAR la bandeja (temporal + os.replace en la raíz): registro_avisos.py atrapa ese error y la
# recortan las colas, que sí tienen la raíz. Escribir siempre puede.
ReadWritePaths=/opt/nodo/datos/temblores /opt/nodo/datos/avisos.jsonl /opt/nodo/datos/avisos-salida.jsonl /opt/nodo/datos/.avisos-salida.lock
ReadOnlyPaths=/opt/botv3/perfiles

[Install]
WantedBy=multi-user.target
