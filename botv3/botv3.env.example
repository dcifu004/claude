# Un archivo por perfil. El real vive en /opt/nodo/datos/secretos/:
#   botv3.env         -> @Dcs_v3bot  (perfil jaime, unidad botv3.service)
#   botv3-pilar.env   -> @Pilar_v2bot (perfil pilar, unidad botv3@pilar.service)
# No guardar tokens ni completar este ejemplo dentro del vault.
#
# Lo que NO va acá: qué vaults y qué rutas le tocan al perfil. Eso vive en
# perfiles/<perfil>.toml, que sí está versionado — un permiso escondido en un
# archivo de secretos no se puede revisar ni diffear.
BOTV3_TOKEN=NO_PONER_AQUI
BOTV3_CHAT_ID=0
BOTV3_USER_ID=0
# La unidad plantilla ya inyecta BOTV3_PERFIL=%i; en la unidad vieja de jaime va acá.
BOTV3_PERFIL=jaime
# Un directorio por perfil, HERMANOS y no anidados (ver DESPLIEGUE-pilar.md).
BOTV3_STATE_DIR=/opt/nodo/datos/botv3
BOTV3_PERSONAL_VAULT=/opt/nodo/datos/srv/vault_personal
BOTV3_WORK_VAULT=/opt/nodo/datos/srv/vault_trabajo
BOTV3_SCHEMA=/opt/botv3/proposal.schema.json
BOTV3_MODEL_TIMEOUT=600
BOTV3_N8N_QUERY_URL=
BOTV3_N8N_AUDIT_URL=
BOTV3_N8N_SHARED_SECRET=
GROQ_API_KEY=
# Proveedores gratis (encargo 15). Sin su key, un proveedor no existe para este bot.
# Se cargan con `sudo cargar-clave <VARIABLE> <perfil>` (pide el valor sin eco), no a mano.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# Modelo por proveedor (opcional; el de por defecto vive en recetas.py). OpenRouter
# acepta hasta 3 separados por coma, todos `:free`.
#BOTV3_GROQ_MODEL=openai/gpt-oss-120b
# Modelo de la ruta web; el valor por defecto usa browser_search en GPT-OSS.
#BOTV3_GROQ_WEB_MODEL=openai/gpt-oss-120b
#BOTV3_GEMINI_MODEL=gemini-3.6-flash
#BOTV3_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
